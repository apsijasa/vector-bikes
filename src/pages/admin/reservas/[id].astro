---
import { DateTime } from "luxon";
import Base from "../../../layouts/Base.astro";
import {
  adminActionSchema,
  applyAdminAction,
  bookingDetail,
  STATUS_LABELS,
  timeRange,
} from "../../../server/admin/agenda.ts";
import { isAllowedOrigin } from "../../../server/api/handlers.ts";
import { requireAdmin, SESSION_COOKIE } from "../../../server/auth/admin-auth.ts";
import { TIMEZONE } from "../../../server/booking/rules.ts";
import { getDb } from "../../../server/db/client.ts";
import { formatClp } from "../../../server/email/templates.ts";

export const prerender = false;

const admin = await requireAdmin(getDb(), Astro.cookies.get(SESSION_COOKIE)?.value, new Date());
if (!admin) {
  return Astro.redirect("/admin/login", 303);
}

Astro.response.headers.set("cache-control", "no-store");

const id = Astro.params.id ?? "";
let error: string | null = null;

if (Astro.request.method === "POST") {
  if (!isAllowedOrigin(Astro.request)) {
    Astro.response.status = 403;
    error = "No pudimos confirmar la solicitud. Recarga la página e intenta de nuevo.";
  } else {
    const form = await Astro.request.formData();
    const action = adminActionSchema.safeParse(form.get("accion"));
    const result = action.success
      ? await applyAdminAction(getDb(), id, action.data, new Date())
      : ({ ok: false, code: "invalid_transition" } as const);
    if (result.ok && action.success) {
      return Astro.redirect(`/admin/reservas/${id}?hecho=${action.data}`, 303);
    }
    if (!result.ok && result.code === "not_found") {
      Astro.response.status = 404;
    } else {
      Astro.response.status = 409;
      error = "Esta acción no aplica al estado actual de la reserva.";
    }
  }
}

const booking = await bookingDetail(getDb(), id);
if (!booking) {
  Astro.response.status = 404;
}

const DONE: Record<string, string> = {
  cancelar: "Reserva cancelada.",
  completar: "Reserva marcada como completada.",
  no_show: "Reserva marcada como no-show.",
};
const done = DONE[Astro.url.searchParams.get("hecho") ?? ""] ?? null;
const localDate = (instant: Date) =>
  DateTime.fromJSDate(instant).setZone(TIMEZONE).toFormat("yyyy-MM-dd HH:mm");
---

<Base
  title="Reserva — Vector Bikes"
  description="Detalle de una reserva."
  path="/admin/reservas"
  chrome="none"
  noindex
>
  <section class="section">
    <div class="wrap">
      <nav class="nav" aria-label="Panel" style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:28px">
        <a href="/admin">Agenda</a>
        <a href="/admin/bloqueos">Bloqueos</a>
        <form method="post" action="/admin/logout">
          <button type="submit" class="btn ghost">Salir</button>
        </form>
      </nav>
      <div class="sec-head">
        <span class="label">Detalle</span>
        <h1>{booking ? booking.code : "Reserva no encontrada"}</h1>
      </div>
      {error && <p role="alert" style="margin-bottom:20px;font-weight:600">{error}</p>}
      {done && <p role="status" style="margin-bottom:20px;font-weight:600">{done}</p>}
      {
        booking ? (
          <aside class="ticket">
            <dl class="ticket-body">
              <div class="row">
                <dt>Estado</dt>
                <dd>{STATUS_LABELS[booking.status] ?? booking.status}</dd>
              </div>
              <div class="row">
                <dt>Día</dt>
                <dd class="mono">{booking.serviceDate}</dd>
              </div>
              <div class="row">
                <dt>Hora</dt>
                <dd class="mono">{timeRange(booking)}</dd>
              </div>
              <div class="row">
                <dt>Modalidad</dt>
                <dd>{booking.mode === "retiro" ? "Retiro y devolución" : "La deja en el taller"}</dd>
              </div>
              <div class="row">
                <dt>Nombre</dt>
                <dd>{booking.customerName}</dd>
              </div>
              <div class="row">
                <dt>Teléfono</dt>
                <dd>
                  <a href={`tel:${booking.phoneE164}`}>{booking.phoneE164}</a>
                </dd>
              </div>
              <div class="row">
                <dt>Correo</dt>
                <dd>
                  <a href={`mailto:${booking.email}`}>{booking.email}</a>
                </dd>
              </div>
              <div class="row">
                <dt>Bicicleta</dt>
                <dd>{booking.bike}</dd>
              </div>
              <div class="row">
                <dt>Qué necesita</dt>
                <dd>{booking.description}</dd>
              </div>
              <div class="row">
                <dt>Comuna / dirección</dt>
                <dd>{booking.comuna ? `${booking.comuna} / ${booking.address ?? ""}` : "—"}</dd>
              </div>
              <div class="row">
                <dt>Consentimiento</dt>
                <dd class="mono">{localDate(booking.consentAt)}</dd>
              </div>
              {
                booking.cancelledAt && (
                  <div class="row">
                    <dt>Cancelada</dt>
                    <dd class="mono">
                      {localDate(booking.cancelledAt)} ({booking.cancelledBy === "admin" ? "taller" : "cliente"})
                    </dd>
                  </div>
                )
              }
            </dl>
            <div class="ticket-total">
              <span class="label">Recargo</span>
              <strong>{formatClp(booking.pickupFeeClp)}</strong>
            </div>
            {
              booking.status === "confirmed" && (
                <div class="ticket-foot" style="display:grid;gap:10px">
                  <form method="post">
                    <input type="hidden" name="accion" value="completar" />
                    <button type="submit" class="btn">
                      Marcar completada
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="accion" value="no_show" />
                    <button type="submit" class="btn ghost">
                      Marcar no-show
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="accion" value="cancelar" />
                    <button type="submit" class="btn ghost">
                      Cancelar reserva
                    </button>
                  </form>
                </div>
              )
            }
          </aside>
        ) : (
          <p>
            <a href="/admin">Volver a la agenda</a>
          </p>
        )
      }
    </div>
  </section>
</Base>
