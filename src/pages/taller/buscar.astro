---
import TallerLayout from "../../layouts/TallerLayout.astro";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../server/auth/permissions.ts";
import { getDb } from "../../server/db/client.ts";
import { searchQuerySchema, searchTaller } from "../../server/taller/search.ts";

export const prerender = false;
const PATH = "/taller/buscar";
const db = getDb();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, new Date());
if (!user)
  return new Response(null, {
    status: 303,
    headers: {
      location: loginRedirect(Astro.url.pathname + Astro.url.search),
      "cache-control": "no-store",
    },
  });
if (!can(user.role, "orders.edit")) return forbiddenResponse();
Astro.response.headers.set("cache-control", "no-store");
const q = Astro.url.searchParams.get("q") ?? "";
const parsed = searchQuerySchema.safeParse(q);
const results = parsed.success
  ? await searchTaller(db, user, parsed.data)
  : { customers: [], orders: [] };
const canManageCustomers = can(user.role, "customers.manage");
---

<TallerLayout title="Buscar — Vector Bikes" description="Busca clientes y órdenes de tu sucursal." path={PATH} user={user}>
  <h1>Buscar</h1>
  <form method="get" action={PATH}>
    <div class="fields">
      <div class="field">
        <label for="workshop-search">Nombre, teléfono, RUT o número de orden</label>
        <input id="workshop-search" name="q" type="search" maxlength="80" value={q} />
      </div>
    </div>
    <button type="submit" class="btn">Buscar</button>
  </form>
  <div style="overflow-x:auto">
    <table class="dense">
      <caption>Clientes de tu sucursal</caption>
      <thead><tr><th scope="col">Nombre</th></tr></thead>
      <tbody>
        {results.customers.map((customer) => (
          <tr>
            <th scope="row">
              {canManageCustomers ? <a href={`/taller/clientes/${customer.id}`}>{customer.name}</a> : customer.name}
            </th>
          </tr>
        ))}
        {results.customers.length === 0 && <tr><td>Sin resultados.</td></tr>}
      </tbody>
    </table>
  </div>
</TallerLayout>
