---
import TallerLayout from "../../../layouts/TallerLayout.astro";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../../server/auth/permissions.ts";
import { getDb } from "../../../server/db/client.ts";
import { listCustomers } from "../../../server/taller/customers.ts";

export const prerender = false;
const PATH = "/taller/clientes";
const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user)
  return new Response(null, {
    status: 303,
    headers: {
      location: loginRedirect(Astro.url.pathname + Astro.url.search),
      "cache-control": "no-store",
    },
  });
if (!can(user.role, "customers.manage")) return forbiddenResponse();
Astro.response.headers.set("cache-control", "no-store");
const customers = await listCustomers(db, user);
---

<TallerLayout title="Clientes — Vector Bikes" description="Clientes recientes del taller." path={PATH} user={user}>
  <h1>Clientes</h1>
  <p><a class="btn" href={`${PATH}/nuevo`}>Nuevo cliente</a></p>
  <form method="get" action="/taller/buscar">
    <div class="fields">
      <div class="field">
        <label for="customer-search">Buscar cliente</label>
        <input id="customer-search" name="q" type="search" />
      </div>
    </div>
    <button type="submit" class="btn">Buscar cliente</button>
  </form>
  <div style="overflow-x:auto">
    <table class="dense">
      <caption>Clientes recientes de tu sucursal</caption>
      <thead><tr><th scope="col">Nombre</th></tr></thead>
      <tbody>
        {customers.map((customer) => (
          <tr><th scope="row"><a href={`${PATH}/${customer.id}`}>{customer.name}</a></th></tr>
        ))}
        {customers.length === 0 && <tr><td>Aún no hay clientes registrados.</td></tr>}
      </tbody>
    </table>
  </div>
</TallerLayout>
