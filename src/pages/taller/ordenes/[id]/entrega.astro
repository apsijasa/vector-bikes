---
import { z } from "zod";
import TallerLayout from "../../../../layouts/TallerLayout.astro";
import { isAllowedOrigin } from "../../../../server/api/handlers.ts";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../../../server/auth/permissions.ts";
import { getDb } from "../../../../server/db/client.ts";
import { formatClp } from "../../../../server/email/templates.ts";
import { formatOrderNumber } from "../../../../server/taller/orders.ts";
import {
  listPayments,
  paymentFormSchema,
  recordPayment,
  voidPayment,
} from "../../../../server/taller/payments.ts";
import {
  PAYMENT_KINDS,
  PAYMENT_KIND_LABELS,
  PAYMENT_METHODS,
  PAYMENT_METHOD_LABELS,
  TERMINAL_STATUSES,
} from "../../../../server/taller/rules.ts";
import { orderDetail } from "../../../../server/taller/status.ts";

export const prerender = false;
const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user)
  return new Response(null, {
    status: 303,
    headers: {
      location: loginRedirect(Astro.url.pathname + Astro.url.search),
      "cache-control": "no-store",
    },
  });
if (Astro.request.method === "POST" && !isAllowedOrigin(Astro.request)) return forbiddenResponse();
if (!can(user.role, "payments.record")) return forbiddenResponse();
Astro.response.headers.set("cache-control", "no-store");

const actionSchema = z.discriminatedUnion("action", [
  paymentFormSchema.extend({ action: z.literal("record") }),
  z.strictObject({ action: z.literal("void"), paymentId: z.uuid() }),
]);
let submitted: Record<string, string> = {};
let parsedInput: ReturnType<typeof actionSchema.safeParse> | undefined;
const fieldErrors = new Set<string>();
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = Object.fromEntries([...form].map(([key, value]) => [key, String(value)]));
  if (submitted.action === "void" && !can(user.role, "payments.void")) return forbiddenResponse();
  parsedInput = actionSchema.safeParse(submitted);
  if (!parsedInput.success) {
    Astro.response.status = 422;
    error = "Revisa el tipo, método y monto del pago. El monto debe ser un entero mayor que cero.";
    for (const issue of parsedInput.error.issues) fieldErrors.add(String(issue.path[0]));
  }
}
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success)
  return new Response("Orden no encontrada.", {
    status: 404,
    headers: { "cache-control": "no-store" },
  });
const detail = await orderDetail(db, user, id.data);
if (!detail.ok) {
  if (detail.code === "forbidden") return forbiddenResponse();
  return new Response("Orden no encontrada.", {
    status: 404,
    headers: { "cache-control": "no-store" },
  });
}
const { order } = detail;
const PATH = Astro.url.pathname;
const payments = await listPayments(db, user, order.id);
if (parsedInput?.success) {
  const input = parsedInput.data;
  const { action, ...fields } = input;
  const result =
    input.action === "record"
      ? await recordPayment(db, user, order.id, fields, now)
      : payments.some((payment) => payment.id === input.paymentId)
        ? await voidPayment(db, user, input.paymentId, now)
        : { ok: false, code: "not_found" };
  if (result.ok)
    return new Response(null, {
      status: 303,
      headers: {
        location: `${PATH}?hecho=${action}`,
        "cache-control": "no-store",
      },
    });
  if (result.code === "forbidden") return forbiddenResponse();
  Astro.response.status =
    result.code === "not_found" ? 404 : result.code === "validation_error" ? 422 : 409;
  const errors: Record<string, string> = {
    invalid_status: "El estado de la orden no permite esta operación de pago.",
    invalid_amount: "El monto debe ser un entero mayor que cero y no superar el saldo.",
    deposit_exists: "Ya hay un abono vigente. Anúlalo antes de registrar otro.",
    not_found: "No se encontró la orden o el pago.",
  };
  error = Object.hasOwn(errors, result.code ?? "")
    ? (errors[result.code ?? ""] ?? "Revisa los datos del formulario.")
    : "Revisa los datos del formulario.";
  if (result.code === "invalid_amount") fieldErrors.add("amountClp");
  if (result.code === "deposit_exists") fieldErrors.add("kind");
}
const number = formatOrderNumber(order.number);
const balance = order.totalClp - order.paidClp;
const editable = !(TERMINAL_STATUSES as readonly string[]).includes(order.status);
const notices: Record<string, string> = { record: "Pago registrado.", void: "Pago anulado." };
const done = Astro.url.searchParams.get("hecho") ?? "";
const notice = Object.hasOwn(notices, done) ? notices[done] : undefined;
function invalid(field: string) {
  return submitted.action === "record" && fieldErrors.has(field);
}
---

<TallerLayout title={`${number} · Pagos y entrega — Vector Bikes`} description="Pagos y saldo de la orden de trabajo." path="/taller/ordenes" user={user}>
  <h1>{number} · Pagos y entrega</h1>
  <p><a class="btn ghost" href={`/taller/ordenes/${order.id}`}>Volver a la orden</a></p>
  {notice && <p role="status">{notice}</p>}
  {error && <p id="form-error" role="alert">{error}</p>}
  <section aria-labelledby="summary-title">
    <h2 id="summary-title">Resumen de pagos</h2>
    <dl><dt>Total</dt><dd>{formatClp(order.totalClp)}</dd>
      <dt>Pagado</dt><dd>{formatClp(order.paidClp)}</dd>
      <dt>Saldo</dt><dd>{formatClp(balance)}</dd></dl>
  </section>
  <div style="overflow-x:auto"><table class="dense">
    <caption>Pagos vigentes</caption>
    <thead><tr><th scope="col">Tipo de pago</th><th scope="col">Método</th>
      <th scope="col">Monto</th><th scope="col">Acciones</th></tr></thead>
    <tbody>{payments.map((payment) => <tr>
      <td>{PAYMENT_KIND_LABELS[payment.kind]}</td><td>{PAYMENT_METHOD_LABELS[payment.method]}</td>
      <td>{formatClp(payment.amountClp)}</td><td>
        {order.status !== "entregada" && can(user.role, "payments.void")
          ? <form method="post" action={PATH}>
              <input type="hidden" name="action" value="void" />
              <input type="hidden" name="paymentId" value={payment.id} />
              <button class="btn ghost" type="submit" aria-label={`Anular ${PAYMENT_KIND_LABELS[payment.kind]} de ${formatClp(payment.amountClp)}`}>Anular</button>
            </form> : <span>Sin acciones</span>}
      </td></tr>)}</tbody>
  </table></div>
  {payments.length === 0 && <p>No hay pagos registrados.</p>}
  {!editable && <p>Esta orden ya no admite nuevos pagos.</p>}
  {editable && <form method="post" action={PATH}>
    <input type="hidden" name="action" value="record" />
    <div class="fields">
      <fieldset><legend>Tipo de pago</legend><div class="options">
        {PAYMENT_KINDS.map((kind) => <label>
          <input name="kind" type="radio" value={kind} required checked={kind === (submitted.action === "record" ? submitted.kind : "final")} aria-invalid={invalid("kind")} aria-describedby={invalid("kind") ? "form-error" : undefined} />
          {PAYMENT_KIND_LABELS[kind]}</label>)}
      </div></fieldset>
      <fieldset><legend>Método</legend><div class="options">
        {PAYMENT_METHODS.map((method) => <label>
          <input name="method" type="radio" value={method} required checked={method === (submitted.action === "record" ? submitted.method : "transferencia")} aria-invalid={invalid("method")} aria-describedby={invalid("method") ? "form-error" : undefined} />
          {PAYMENT_METHOD_LABELS[method]}</label>)}
      </div></fieldset>
      <div class="field"><label for="amountClp">Monto</label>
        <input id="amountClp" name="amountClp" type="number" min="1" max={balance} step="1" required value={submitted.action === "record" ? submitted.amountClp : balance} aria-invalid={invalid("amountClp")} aria-describedby={invalid("amountClp") ? "form-error" : undefined} />
      </div>
      <button class="btn" type="submit">Registrar pago</button>
    </div>
  </form>}
  <section aria-labelledby="delivery-title">
    <h2 id="delivery-title">Entrega y firma</h2>
    <!-- E4-T6: completar la entrega con saldo cero y firma del cliente. -->
    <p>La entrega con firma estará disponible en el siguiente paso.</p>
  </section>
</TallerLayout>
